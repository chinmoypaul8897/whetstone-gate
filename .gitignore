htmlcov/
.tox/
.nox/
coverage.xml

# ── vendor/ ───────────────────────────────────────────────────────────────────
# ⚠️ THE VENDORED SOURCE TREES ARE NOT COMMITTED. See QUESTIONS.md Q-010 and
# vendor/MANIFEST.md, which pins every SHA and gives the exact commands to reproduce
# each checkout byte for byte.
#
# MEASURED, 2026-08-30: tau2-bench at the pinned SHA is 793.2 MB across 1,564 tracked
# files, of which ~450 MB is data/tau2/results/ — OTHER PEOPLE'S published model runs,
# which this project never reads. Committing it would put a ~0.8 GB clone between a
# judge and CONTEXT.md §20's "git clone -> one command -> it runs", and §1's headline
# claim is that a reviewer can re-run every number AT ZERO COST on the free tier.
# What ships instead is the MANIFEST plus C13's committed empty-diff proof.
vendor/*/
!vendor/MANIFEST.md

# ── evals/ TRANSIENT ARTEFACTS ONLY ───────────────────────────────────────────
# ⚠️ evals/ CONTENT IS COMMITTED EVIDENCE, NOT IGNORED OUTPUT. See QUESTIONS.md Q-003.
# CONTEXT.md §16 requires evals/episodes/ to hold "every transcript, including boring
# ones"; PROCESS.md §9 requires every claim-from-data to ship its committed output
# under docs/evidence/ or evals/; PROCESS.md §6b requires evals/cal/RUN_DECLARED.md and
# evals/pilot/RUN_DECLARED.md to be pushed BEFORE their runs start. Ignoring evals/
# outputs would make the submission's central evidence unshippable. Only genuinely
# transient in-flight files are ignored.
evals/**/*.partial
evals/**/*.tmp
evals/**/*.lock
evals/**/tmp/
evals/**/.checkpoint-inflight/

